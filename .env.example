# Local Docker Compose database
POSTGRES_DB=aurix
POSTGRES_USER=aurix
POSTGRES_PASSWORD=change_me_local_only

# FastAPI
# Use URL-encoded credentials if your password contains reserved URI characters.
# For local Docker Compose, the PostgreSQL hostname is `postgres` instead of `localhost`.
DATABASE_URL=postgresql+psycopg://aurix:change_me_local_only@postgres:5432/aurix
DATABASE_URL_MIGRATIONS=postgresql+psycopg://aurix:change_me_local_only@postgres:5432/aurix
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
ENVIRONMENT=development

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
